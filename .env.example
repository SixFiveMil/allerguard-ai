# AllerGuard AI Environment Configuration

# Core Open LLM (Google Gemma 2)
# Supports: local ollama (http://localhost:11434/v1), vLLM endpoint, or OpenRouter/Groq API key
GEMMA_API_BASE=http://localhost:11434/v1
GEMMA_MODEL=gemma2:9b
GEMMA_API_KEY=ollama

# Prior Labs TabPFN (Tabular Foundation Model)
# Set to 'true' to enable local TabPFN neural prior inference
TABPFN_ENABLED=true

# SerpApi (Real-time Web Grounding for Food Recalls & Brand Cross-Contamination)
SERPAPI_API_KEY=your_serpapi_key_here

# ElevenLabs (Hands-free Voice Accessibility & Audio Briefing)
ELEVENLABS_API_KEY=your_elevenlabs_key_here
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Sentry Agent Tracing (Telemetry, Token Counts, Tool Latencies)
SENTRY_DSN=your_sentry_dsn_here
SENTRY_ENVIRONMENT=production

# Server Settings
PORT=8000
HOST=0.0.0.0
